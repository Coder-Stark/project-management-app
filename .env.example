# Address of the frontend that is allowed to call this API (CORS). No path, no spaces.
CLIENT_URL=http://localhost:5173
PORT=8080
# MongoDB Atlas connection string. Ask the project owner or use your own.
MONGODB_URI=<your MongoDB connection string>
# Generate one with: node -p "require('crypto').randomBytes(32).toString('hex')"
JWT_SECRET=<a long random string, at least 16 characters>
JWT_EXPIRES_IN=7d